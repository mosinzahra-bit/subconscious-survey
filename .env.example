# Copy to .env.local for local dev. In Vercel, add these in Project → Settings → Environment Variables.

# Supabase (required for auth)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Database (Supabase → Settings → Database → Connection string URI)
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Optional: Redis for Passive Intelligence background jobs
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
