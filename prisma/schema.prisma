generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           String          @id @default(cuid())
  email        String          @unique
  companyName  String
  plan         Plan            @default(STARTER)
  createdAt    DateTime        @default(now())
  studies      Study[]

  businessType String?         // "B2B" | "B2C" | "E-commerce" | "Service" | "SaaS"
  industry     String?
  targetMarket String?
  calendlyUrl  String?
  slackWebhook String?
}

enum Plan {
  STARTER     // $499/study
  RETAINER    // $800/mo unlimited studies
  ENTERPRISE
}

model Study {
  id                String            @id @default(cuid())
  clientId          String
  client            Client            @relation(fields: [clientId], references: [id])
  title             String
  description       String?
  status            StudyStatus       @default(DRAFT)
  shareToken        String            @unique @default(cuid())
  config            Json              // StudyConfig JSON
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  sessions          Session[]

  participantMode   ParticipantMode   @default(LIVE_IAT)
  passiveJobStatus  String?
  passiveJobProgress Json?
  strategyReports   StrategyReport[]
  diyToolkitUrl     String?

  passiveSamples    PassiveSample[]
}

enum StudyStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ParticipantMode {
  LIVE_IAT
  PASSIVE_INTELLIGENCE
}

model Session {
  id              String    @id @default(cuid())
  studyId         String
  study           Study     @relation(fields: [studyId], references: [id])
  participantCode String
  deviceInfo      Json?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  isValid         Boolean?
  dScore          Float?
  dScoreLabel     String?
  invalidReason   String?
  trials          Trial[]
}

model Trial {
  id              String   @id @default(cuid())
  sessionId       String
  session         Session  @relation(fields: [sessionId], references: [id])
  blockIndex      Int
  trialIndex      Int
  stimulus        String
  stimulusType    String
  correctKey      String
  pressedKey      String
  isCorrect       Boolean
  reactionTimeMs  Int
  hadError        Boolean
  errorPenaltyMs  Int      @default(0)
}

model PassiveSample {
  id               String   @id @default(cuid())
  studyId          String
  study            Study    @relation(fields: [studyId], references: [id])
  source           String   // "reddit", "reviews", "twitter", etc.
  rawText          String
  url              String?
  collectedAt      DateTime @default(now())
  conceptA_score   Float?
  conceptB_score   Float?
  valenceScore     Float?
  linguisticMarkers Json?
  isValid          Boolean  @default(true)
}

model StrategyReport {
  id             String   @id @default(cuid())
  studyId        String
  study          Study    @relation(fields: [studyId], references: [id])
  generatedAt    DateTime @default(now())
  reportData     Json
  pdfUrl         String?
  toolkitUrl     String?
  diyRequested   Boolean  @default(false)
  dfyRequested   Boolean  @default(false)
  dfyRequestedAt DateTime?
  version        Int      @default(1)
}

